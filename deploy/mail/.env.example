# The name the server gives itself (HELO). Point its A record at the server and
# set the server IP's reverse DNS (PTR) to the same name.
MAIL_HOSTNAME=mail.example.com
# Domains allowed in From (comma-separated). Each needs SPF, DKIM and DMARC records.
ALLOWED_SENDER_DOMAINS=example.com
# DKIM key name: the record goes at <selector>._domainkey.<domain>.
DKIM_SELECTOR=mail
