# Host port for the web UI (nginx proxies /api and /hls). Chosen to avoid
# clashing with other stacks on the dev machine.
WEB_PORT=28700
# Postgres, exposed on the host for debugging only.
PG_PORT=28732
POSTGRES_PASSWORD=change-me
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# Public origin for OAuth / MCP (e.g. https://radio.example.com). Leave empty
# to derive it from each request. Needed behind TLS-terminating proxies.
PUBLIC_URL=
# Shown in the privacy notice: who runs this radio (person or organisation)
# and how listeners reach them about their data (an email address).
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=
# Also in the notice: who hosts the servers (name, address, phone) and where the data is stored.
# HOSTING_PROVIDER=Example Hosting SAS, 1 rue Exemple, 75000 Paris, France, +33 1 23 45 67 89
# DATA_LOCATION=France
# Disk space for downloaded songs, in GB (about 4.5 MB a song).
# CACHE_SIZE_GB=2
# Released images (scripts/deploy.sh --pull). Leave unset to build locally.
# SERVER_IMAGE=ghcr.io/slicit/the-last-radio-server:1.0.0
# WEB_IMAGE=ghcr.io/slicit/the-last-radio-web:1.0.0
# Email (confirmation links for private stations' domain rules).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=The Last Radio <radio@example.com>
